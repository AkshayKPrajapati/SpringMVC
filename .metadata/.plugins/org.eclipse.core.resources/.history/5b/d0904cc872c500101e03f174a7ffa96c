<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
    pageEncoding="ISO-8859-1"%>
<%@ page import="com.mvcormdata.entity.Books"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="ISO-8859-1">
<title>Update Book</title>
</head>
<body>

<%
    Books book = (Books) request.getAttribute("bookDetails");
%>

<center>
    <h2>Update Book Details</h2>
</center>

<form action="updateSuccess" method="post">

    <input type="text" placeholder="Book Id" id="bookId" 
           name="bookId" value="<%= book.getBookId() %>" readonly disabled="disabled">

    <input type="text" placeholder="Enter Book Name" id="bookName" 
           name="bookName" value="<%= book.getBookName() %>" required>

    <input type="text" placeholder="Enter Author Name" id="bookAuthor" 
           name="bookAuthor" value="<%= book.getBookAuthor() %>" required>

    <input type="text" placeholder="Enter Description" id="bookDescription" 
           name="bookDescription" value="<%= book.getBookDescription() %>" required>

    <input type="text" placeholder="Enter Price (₹)" id="bookPrice" 
           name="bookPrice" value="<%= book.getBookPrice() %>" required>

    <input type="submit" value="Update Book Details">

</form>

</body>
</html>
