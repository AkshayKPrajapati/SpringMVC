<%@ page language="java" contentType="text/html; charset=ISO-8859-1"
    pageEncoding="ISO-8859-1"%>
    
<%@ page import="java.util.List"%>
<%@ page import="com.mvcormdata.entity.Books"%>
<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-1">
<title>Insert title here</title>
</head>
<body>
	<p>Added successfully</p>
	<%
	
	List<Books> ListOfBook=(List<Books> )request.getAttribute("booksDetails");
	
	%>
	<h3>List of Books</h3>
	
	<%for (Books book:ListOfBook) {
	%>
		
		Book ID : <%=book.getBookId() %>
		Book Name : <%=book.getBookName() %>
		Book Auther: <%=book.getBookAuthor() %>
		Book Discription: <%=book.getBookDescription() %>
		Book Price: <%=book.getBookPrice()%>
		
	<%} %>
	
</body>
</html>