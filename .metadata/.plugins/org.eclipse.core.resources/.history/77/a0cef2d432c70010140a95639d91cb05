package com.mvcexception.exception;

import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.ControllerAdvice;
import org.springframework.web.bind.annotation.ExceptionHandler;

@ControllerAdvice
public class HandlerAllExceptions {
	
	
	//1 : Specific Handling Exception Method
		// ArithmeticException Exception Handling
		@ExceptionHandler(value=ArithmeticException.class)
		public String handlingArithmeticException(Model model){
			model.addAttribute("msg","Arithmetic exception occured !");
			return "error";
		}
		
		//Exception Null
		@ExceptionHandler(value=NullPointerException.class)
		public String handlingNullPointerException(Model model){
			model.addAttribute("msg","NullPointer exception occured !");
			return "error";
		}
		
		
		/*
		 * 2 . Generalize Handler Exception
		 */
		@ExceptionHandler(value=Exception.class)
		public String handlingException(Model model){
			model.addAttribute("msg","NullPointer exception occured !");
			return "error";
		}
	
}
