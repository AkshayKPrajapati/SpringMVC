    	ModelAndView modelAndView=new ModelAndView();
    	modelAndView.addObject("name","Ajay");
    	modelAndView.addObject("mobile", 6200305994L);
    	modelAndView.addObject("studentData", new Student(101, "Akshay", "FISJFS01625"));
    	modelAndView.addObject("name","Ajay");
    	 List<Integer> pincodes = new ArrayList<>();
         pincodes.add(821654);
         pincodes.add(821655);
         pincodes.add(821656);
         modelAndView.addObject("pincodes", pincodes);
         //which view we want to show 
         modelAndView.setViewName("modelview");
         return modelAndView;
    }
    
    
    
